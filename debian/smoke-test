#!/bin/bash
# Checks the installed ros-jazzy-ros2-topic-tracing. Run from the repo root
# (uses test/data). CI runs it after installing the .deb; works locally too.
set -euo pipefail
source /opt/ros/jazzy/setup.bash
P=ros2_topic_tracing
prefix=$(ros2 pkg prefix $P)
test "$prefix" = /opt/ros/jazzy
"$prefix/lib/$P/trace_daemon" check
for cmd in trace_ctl topic_stats topic_diagnostics; do
    ros2 run $P $cmd -h > /dev/null
done
# installed scripts find the installed daemon (not a checkout's)
ros2 run $P topic_stats --trace "$PWD/test/data/talker_listener" -f csv -t /chatter | grep -q /talker
ros2 launch $P topic_diagnostics.launch.py --show-args | grep -q config
test -f "$prefix/share/$P/config/example.yaml"
echo "smoke test ok"
